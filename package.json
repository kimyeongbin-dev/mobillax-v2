{
  "name": "mobillax-dev-tools",
  "private": true,
  "description": "MobilLax 프론트엔드 린트·포맷과 Git 훅용 개발 도구 (앱 실행에는 필요 없음)",
  "scripts": {
    "lint": "eslint src/main/resources/static .claude/hooks",
    "format": "prettier --write \"src/main/resources/static/**/*.{js,css}\" \".claude/hooks/*.js\"",
    "format:check": "prettier --check \"src/main/resources/static/**/*.{js,css}\" \".claude/hooks/*.js\"",
    "test:hooks": "node .claude/hooks/guard-secrets.test.js && bash .githooks/secret-scan.test.sh"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint"
    ],
    "*.css": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10"
  }
}
