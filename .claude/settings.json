{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Read(./**/.env.*.local)",
      "Edit(./.env)",
      "Edit(./**/.env)",
      "Edit(./.env.local)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "Bash(docker compose config*)",
      "Bash(docker inspect*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Grep|Glob|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-secrets.js\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
