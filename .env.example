# ==========================================================
# MobilLax 환경 변수 템플릿
# - 이 파일을 .env 로 복사한 뒤 값을 채웁니다. (.env 는 커밋되지 않음)
# - 각 키의 발급 방법: docs/ENV_SETUP.md
# - 값 뒤에 주석(# ...)을 붙이지 마세요. 값의 일부로 읽힐 수 있습니다.
# ==========================================================

# ----------------------------------------
# 🐬 데이터베이스 (docker compose 의 MySQL)
# ----------------------------------------
# docker compose 의 MySQL 서비스 이름
DB_HOST=db
DB_PORT=3306
DB_NAME=MobilLaxDB
DB_USERNAME=mobillax
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# 위 값으로 조합되므로 수정하지 않음
SPRING_DATASOURCE_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}?useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=${DB_USERNAME}
SPRING_DATASOURCE_PASSWORD=${DB_PASSWORD}

# ----------------------------------------
# 🗺️ TMAP (SK open API)
# ----------------------------------------
# 서버에서 호출하는 키 (RouteServiceImpl)
TMAP_APPKEY=your-tmap-appkey
# 브라우저용 키 (home/route 템플릿 SDK, map.html 의 /module/config.js)
TMAP_WEB_APPKEY=your-tmap-appkey

# ----------------------------------------
# 🗺️ 카카오 지도 (JavaScript 키)
# ----------------------------------------
KAKAO_JS_APPKEY=your-kakao-javascript-key

# ----------------------------------------
# 💳 포트원 V2 결제
# ----------------------------------------
PORTONE_STORE_ID=store-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PORTONE_CHANNEL_KEY=channel-key-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# V2 API Secret (서버 전용, 현재 코드에서는 아직 미사용)
PORTONE_APPKEY=your-portone-v2-api-secret

# ----------------------------------------
# 🚌 공공데이터포털 - 국토교통부_(TAGO)_시외버스정보
# ----------------------------------------
# 일반 인증키(Encoding) 값
BUS_API_KEY=your-data-go-kr-encoding-key
BUS_API_URL_CTYCODE=http://apis.data.go.kr/1613000/SuburbsBusInfoService/getCtyCodeList
BUS_API_URL_TERMINAL=http://apis.data.go.kr/1613000/SuburbsBusInfoService/getSuberbsBusTrminlList
BUS_API_URL_SCHEDULE=http://apis.data.go.kr/1613000/SuburbsBusInfoService/getStrtpntAlocFndSuberbsBusInfo

# ----------------------------------------
# ⚙️ 스프링 / JPA / 로그 (보통 수정 불필요)
# ----------------------------------------
SPRING_PROFILES_ACTIVE=default
SERVER_PORT=8080
# create, update, validate, none
JPA_DDL_AUTO=update
SHOW_SQL=true
FORMAT_SQL=true
SPRING_HTTP_ENCODING_CHARSET=UTF-8
SPRING_HTTP_ENCODING_ENABLED=true
SPRING_HTTP_ENCODING_FORCE=true
SPRING_JACKSON_TIME_ZONE=Asia/Seoul
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_EXAMPLE=DEBUG
